# Copy this file to backend/.env and fill in real values.
# Never commit the actual .env file.

ENVIRONMENT=development

# Comma-separated list of origins allowed to call the API.
# In production, set this to your real domain(s), e.g.:
# ALLOWED_ORIGINS=https://likitha.dev,https://www.likitha.dev
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Where contact-form messages are delivered.
CONTACT_RECEIVER_EMAIL=pilla.likitha@gmail.com

# Option 1 (recommended, required on Railway Free/Hobby, which block SMTP):
# Resend HTTPS API. Sign up at resend.com with the same email as above and create an API key.
# Without a verified domain, Resend only delivers to your own account email, which is fine here.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Option 2 (fallback): SMTP, e.g. Gmail with 2FA + an App Password. Used only if RESEND_API_KEY is empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Rate limit for the contact endpoint, per IP address.
CONTACT_RATE_LIMIT=5/hour

# Path to the SQLite database file (relative to where the app is run from).
DATABASE_PATH=data/submissions.db
