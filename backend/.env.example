# Copy this file to backend/.env and fill in real values.
# Never commit the actual .env file.

ENVIRONMENT=development

# Comma-separated list of origins allowed to call the API.
# In production, set this to your real domain(s), e.g.:
# ALLOWED_ORIGINS=https://likitha.dev,https://www.likitha.dev
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# SMTP credentials used to email contact-form submissions.
# For Gmail: enable 2FA, then create an "App Password" — do not use your real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
CONTACT_RECEIVER_EMAIL=likitha.r@example.com

# Rate limit for the contact endpoint, per IP address.
CONTACT_RATE_LIMIT=5/hour

# Path to the SQLite database file (relative to where the app is run from).
DATABASE_PATH=data/submissions.db
